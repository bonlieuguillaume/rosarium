# Copy to .env (never committed) and fill in. Read by docker-compose.yml.

# --- CDSE S3 credentials (downloads) ---------------------------------------
# rclone reads its `cdse` remote from these variables, instead of the
# `rclone config` file of a conda install: same settings as the [cdse]
# section in features/download_products/README.md. Keys come from
# https://eodata-s3keysmanager.dataspace.copernicus.eu/
RCLONE_CONFIG_CDSE_TYPE=s3
RCLONE_CONFIG_CDSE_PROVIDER=Other
RCLONE_CONFIG_CDSE_ENDPOINT=https://eodata.dataspace.copernicus.eu
RCLONE_CONFIG_CDSE_REGION=default
RCLONE_CONFIG_CDSE_ACCESS_KEY_ID=
RCLONE_CONFIG_CDSE_SECRET_ACCESS_KEY=

# --- Webmap port on this computer -------------------------------------------
# Change it if 8050 is already taken.
ROSARIUM_PORT=8050

# --- Linux only: owner of the files written into data/ ----------------------
# Your `id -u` and `id -g` (1000 on most machines). Changing them needs a
# rebuild: docker compose up --build
ROSARIUM_UID=1000
ROSARIUM_GID=1000
