# Line endings by file kind, whatever the machine's core.autocrlf:
# shell scripts must be LF to run on Linux, batch files CRLF for cmd.exe
* text=auto
*.sh  text eol=lf
*.command text eol=lf
*.bat text eol=crlf
*.py  text eol=lf
*.js  text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.ipynb text eol=lf
*.xml text eol=lf
*.txt text eol=lf

# Binaries
*.ico binary
*.png binary
*.svg text eol=lf
