# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.ruff_cache/
.mypy_cache/
.pytest_cache/
.ipynb_checkpoints/

# --- Environments ---
.venv/
venv/
env/
.env

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
tempCodeRunnerFile.py

# --- Data: never committed, the folders stay (.gitkeep) ---
# raw/           Sentinel-1 SLC / GRD products
# preprocessed/  processing outputs
# utils/         intermediates: path files (.txt), AOIs (.geojson)...
data/raw/*
data/preprocessed/*
data/utils/*
!data/*/.gitkeep

# Sentinel-1 products and heavy rasters anywhere else in the tree
*.SAFE/
*.tif
*.tiff
*.nc
# SNAP intermediate products (BEAM-DIMAP: header + band folder)
*.dim
*.data/

# --- SNAP / JVM ---
# Crash reports written by the Java VM when gpt dies (out of memory...). They
# land in the current directory of the process, i.e. wherever the pipeline
# was launched from — hence no leading path.
hs_err_pid*.log
